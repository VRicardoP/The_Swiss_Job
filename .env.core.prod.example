# jobhunt-core — variables de PRODUCCIÓN (runtime: redis-core / core-api / core-worker)
# Copiar a `.env.core.prod` (en QNAP: /share/Public/swissjob/.env.core.prod) y rellenar.
#
# AISLAMIENTO (revisión externa A-01 #1): los servicios del core NO reciben el
# .env.prod legacy (contiene credenciales admin de Postgres, SECRET_KEY, claves
# externas...). Este fichero es su ÚNICO dominio de secretos en runtime.
# El validador de config EXIGE en prod: usuario jobhunt_core, host redis-core y
# contraseñas reales (no las de dev) — el core no arranca si no se cumplen.

CORE_ENV=prod
CORE_DATABASE_URL=postgresql+asyncpg://jobhunt_core:CAMBIA_PASSWORD_DB@postgres:5432/swissjobhunter
CORE_BROKER_URL=redis://:CAMBIA_PASSWORD_REDIS@redis-core:6379/0
CORE_RESULT_BACKEND=redis://:CAMBIA_PASSWORD_REDIS@redis-core:6379/1
# CORE_REDIS_PASSWORD va en .env.core.redis.prod (solo redis-core la recibe).

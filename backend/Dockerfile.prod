# Backend producción — API y tareas de producto, sin cosecha local.
FROM python:3.12-slim

# curl respalda el healthcheck sin arrastrar un toolchain de compilación.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Python sin buffering para que los logs salgan al stdout en tiempo real
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

RUN useradd --create-home --shell /bin/bash app

WORKDIR /app

# Cache de pip layer: requirements antes que el código
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia del código + entrypoint ejecutable
COPY . .
RUN chmod +x scripts/entrypoint.sh && chown -R app:app /app

USER app

EXPOSE 8000

ENTRYPOINT ["./scripts/entrypoint.sh"]
CMD ["gunicorn", "main:app", \
     "-w", "2", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--timeout", "420"]

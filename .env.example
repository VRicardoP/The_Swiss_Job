# ── PostgreSQL ──────────────────────────────────────
# C7: SIN contraseña por defecto. La que había aquí («swissjob_dev_2024») está
# publicada en este repositorio, y el compose la usaba como default silencioso:
# quien no rellenara este fichero levantaba una base con una clave conocida.
# Ahora el compose EXIGE POSTGRES_PASSWORD y no arranca sin ella.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=swissjob
POSTGRES_PASSWORD=
POSTGRES_DB=swissjobhunter
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Misma contraseña que POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://swissjob:__CHANGE_ME__@postgres:5432/swissjobhunter

# ── Redis ──────────────────────────────────────────
# C7: `redis` exige contraseña (antes aceptaba conexiones anónimas). Basta con
# ponerla aquí: config.py construye REDIS_URL y las dos URLs de Celery a partir
# de ella, para que no haya cuatro copias de la misma clave que rotar aparte.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Celery ─────────────────────────────────────────
# REDIS_URL, CELERY_BROKER_URL y CELERY_RESULT_BACKEND ya NO se declaran aquí.
# Si las declaras, PON LA CONTRASEÑA dentro: Celery lee CELERY_BROKER_URL del
# entorno y esa variable gana sobre el valor que le pasa el código — con la URL
# sin credencial el worker se queda fuera (NOAUTH) aunque el BFF entre bien.

# ── Backend ────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5174","http://localhost:5173"]
SECRET_KEY=change-me-in-production
# C7: el arranque muere si DATABASE_URL trae una contraseña de dev o un marcador
# de plantilla. Ponlo a true SOLO en una máquina de desarrollo, y a sabiendas:
# es lo único que distingue tu portátil de un servidor (el backend legacy no
# tiene CORE_ENV). No existe en .env.prod.example a propósito.
ALLOW_DEV_CREDENTIALS=false

# ── JWT ───────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Provider API Keys ─────────────────────────────
JSEARCH_RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_AFFID=

# ── Host ports (docker-compose) ───────────────────
# C7: a qué interfaz del host se publican postgres, redis, el BFF y core-api.
# 127.0.0.1 = sólo esta máquina. Ponerlo a 0.0.0.0 los expone a toda la LAN;
# hazlo sólo si lo necesitas y con contraseñas reales.
HOST_BIND_IP=127.0.0.1
HOST_POSTGRES_PORT=5435
HOST_REDIS_PORT=6380
HOST_BACKEND_PORT=8002
HOST_FRONTEND_PORT=5174
HOST_REDIS_CORE_PORT=6381
HOST_CORE_API_PORT=8003

# ── jobhunt-core (Fase A/B) ───────────────────────
# Defaults de dev del docker-compose.yml; en prod van en .env.core.*.prod
# (plantillas .env.core.*.prod.example — NUNCA en el .env.prod legacy).
CORE_DB_PASSWORD=jobhunt_core_dev
CORE_REDIS_PASSWORD=core_redis_dev
# Rol de replicación de la sombra (B-01): misma clave en el bootstrap de
# core-migrate y en el CAPTURE_DSN de core-capture.
CORE_CAPTURE_PASSWORD=jobhunt_capture_dev

# ── A.SEAM: costura BFF→core por capacidad (plan §15bis) ──
# URL interna del /v1 del core (solo red interna de compose, nunca ngrok)
CORE_API_BASE_URL=http://core-api:8000/v1
# Credencial de consumer emitida por el core, formato "key_id.secret" (ADR-09).
# El consumer del BFF ES `swissjob-shadow` (CONTRATOS §3: es el consumer de
# SwissJob; el flip de Fase C lo consolida) — su credencial ve los perfiles
# que proyecta la sombra (external_ref = users.id).
# La comparten catálogo (vacancies:read), matching (matches:read) y perfiles (profiles:read).
# Vacía ⇒ cero peticiones al core (core_read cae a local, core_primary → 503).
# Valor real de dev en .env.aseam.local (gitignorado) o añadir a .env manualmente.
CORE_CONSUMER_KEY=
# Timeout HTTP hacia el /v1 del core, en segundos
CORE_HTTP_TIMEOUT_SECONDS=5.0
# TTL de la caché en proceso del routing jobhunt_routing (segundos): acota la
# staleness entre procesos/workers; la invalidación transaccional cubre el local
ROUTING_CACHE_TTL_SECONDS=5.0

# ── Scheduler ─────────────────────────────────────
SCHEDULER_ENABLED=True
# Cosecha diaria autónoma (fetch → embeddings → dedup → matching) UNA vez al día
# a hora VARIABLE (patrón circadiano). True = sustituye al fetch por intervalos.
SCHEDULER_DAILY_HARVEST_ENABLED=True
SCHEDULER_DAILY_HARVEST_HOUR=12
SCHEDULER_DAILY_HARVEST_JITTER_HOURS=4

# Google Gemini — proveedor primario de generación de documentos (free tier) y
# FALLBACK del re-ranking del matching (resiliencia si Groq caduca/satura).
# Vacío = solo Groq. Modelo: GEMINI_MODEL (gemini-2.5-flash)
GEMINI_API_KEY=

# === Email (SMTP) para avisos ===
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, y una App Password (16 car.,
# requiere 2FA) como SMTP_PASSWORD. Vacío = avisos desactivados.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=True

# === Alerta: ofertas de profesor de primaria (colegios suizos) → email ===
TEACHER_ALERT_ENABLED=True
TEACHER_ALERT_EMAIL=amoore3199@gmail.com

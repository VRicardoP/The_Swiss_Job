# jobhunt-core — credencial de ADMIN para el bootstrap. SOLO core-migrate.
# Copiar a `.env.core.admin.prod` (QNAP: /share/Public/swissjob/.env.core.admin.prod).
#
# NUNCA dar este fichero a core-api / core-worker (revisión externa A-01 #1):
# el DSN admin permitiría saltarse el rol de mínimo privilegio.

CORE_ADMIN_DATABASE_URL=postgresql://swissjob:PASSWORD_ADMIN_POSTGRES@postgres:5432/swissjobhunter
CORE_DB_PASSWORD=CAMBIA_PASSWORD_DB

# B-01 (sombra): contraseña del rol de REPLICACIÓN jobhunt_capture — el
# bootstrap de core-migrate lo crea/converge con ella. DEBE coincidir con la
# parte :password@ del CAPTURE_DSN de .env.core.capture.prod. Formato
# aceptado por el bootstrap: solo [A-Za-z0-9_-], 8-128 caracteres.
CORE_CAPTURE_PASSWORD=CAMBIA_PASSWORD_CAPTURE
